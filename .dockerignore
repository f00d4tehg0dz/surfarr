node_modules
**/node_modules
.git
.gitignore
.github
*.md

# Environment files — NEVER bake these into the image. A developer's server/.env
# once shipped a Windows yt-dlp path to every Linux user.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Client build artifacts (rebuilt in Docker)
client/dist
server/public

# Server local state (persisted via Docker volume)
server/db
server/data/commercials/*
plugins/

# API server (has its own image: api-server/Dockerfile) and scripts
api-server/
scripts/

# IDE / OS
.vscode
.idea
*.swp
*.swo
Thumbs.db
.DS_Store
.history

# surfarr-private extras never needed in the image
landing/
yaml/
claude.md
.claude/
