{
  "name": "surfarr-server",
  "version": "1.1.0",
  "description": "SurfArr backend — HDHomeRun emulation + YouTube linear TV",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node -e \"require('fs').readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execFileSync(process.execPath,['--check','src/'+f]))\" && echo syntax ok"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lowdb": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
