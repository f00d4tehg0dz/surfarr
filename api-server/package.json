{
  "name": "surfarr-api",
  "version": "1.0.0",
  "description": "SurfArr API: serves channel lineups and video metadata (YouTube + Internet Archive) from MongoDB to SurfArr servers",
  "main": "src/index.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "import": "node scripts/import-yaml.js",
    "import:dry": "node scripts/import-yaml.js --dry-run",
    "import:plugins": "node scripts/import-plugins.js",
    "import:live": "node scripts/import-live.js",
    "maintenance": "node src/jobs/maintenance.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^2.0.3",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "winston": "^3.13.0"
  }
}
