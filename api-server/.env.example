# SurfArr API configuration
# Copy to .env for a manual (non-Docker) install. Real environment variables
# always win over this file, and it is never copied into the Docker image.

# MongoDB connection string
#   docker-compose: mongodb://mongo:27017/surfarr
#   with a user:    mongodb://user:password@host:27017/surfarr?authSource=admin
#   Atlas:          mongodb+srv://user:password@cluster.mongodb.net/surfarr
MONGO_URI=mongodb://localhost:27017/surfarr

# Port for the API server
PORT=3001

# Which channels /config lists:
#   auto   - every channel that has playable videos in MongoDB (self-hosting)
#   static - the built-in list in src/channels/disabled.js
CHANNEL_GRID_MODE=auto

# Rate limiting (per IP). One SurfArr sync is roughly 60 requests.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
SLOW_DOWN_AFTER=100
SLOW_DOWN_DELAY_MS=500

# Set to 1 behind nginx / Caddy / Traefik, 2 behind Cloudflare + a proxy, 0 if direct
TRUST_PROXY=0

# Log level: error | warn | info | debug
LOG_LEVEL=info
NODE_ENV=production

# Content rules: no "compilation" videos, nothing under 15 minutes, except the
# minimums listed here. Commercials, Bumpers, Theme Songs and Trailers are exempt.
HOUSE_RULE_MIN_MINUTES="Cartoons=6,Kids=6,Talk TV=5"
# Videos cut by the rules are deleted after this many days (0 = keep them flagged)
HOUSE_RULE_PURGE_DAYS=7

# Daily maintenance (private/removed videos, live status, playlist counts). Hour is UTC.
MAINTENANCE_ENABLED=true
MAINTENANCE_HOUR=4
MAINTENANCE_CHECKS_PER_RUN=15000
MAINTENANCE_CONCURRENCY=3

# Importers (scripts/). Leave unset to use yt-dlp from PATH and ./yaml.
#YTDLP_PATH=yt-dlp
#YTDLP_COOKIES=./cookies.txt
#YAML_DIR=./yaml
#PLUGIN_REPO_DIR=../plugin-repo
